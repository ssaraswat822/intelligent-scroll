# Pick one provider. Groq is recommended: it is fast enough to generate a batch
# inside Netlify's 10 second function limit.
GROQ_API_KEY=

# Optional alternatives
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional overrides
# AI_PROVIDER=groq          # groq | anthropic | openai
# GROQ_MODEL=llama-3.3-70b-versatile
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# OPENAI_MODEL=gpt-4o-mini
